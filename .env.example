# --- Required secrets -------------------------------------------------------
# Encrypts source passwords stored in SQLite. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the stored passwords unreadable (re-enter them via PATCH /sources/{id}).
GUARDIAN_ENCRYPTION_KEY=

# Signs download URLs (HMAC). At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GUARDIAN_SIGNING_KEY=

# Secret required (header X-Clone-Key) to preview or start a clone into another server.
# Leave empty to disable cloning. Generate one like the signing key.
GUARDIAN_CLONE_KEY=

# A clone restore running longer than this is killed and marked failed.
GUARDIAN_CLONE_TIMEOUT_SECONDS=14400

# --- Optional ---------------------------------------------------------------
# IANA timezone used for cron schedules and for timestamps in API responses.
GUARDIAN_DISPLAY_TZ=America/Lima

# Origins allowed to call the API from a browser (the intranet UI), comma-separated.
GUARDIAN_CORS_ORIGINS=

# Lifetime of signed download URLs, in seconds.
GUARDIAN_DOWNLOAD_TTL_SECONDS=900

# Successful backups kept per source when a source does not set its own retention.
GUARDIAN_DEFAULT_RETENTION=3

# If the service was down at a scheduled time, run the missed backup on startup
# when it is at most this many seconds late.
GUARDIAN_MISFIRE_GRACE_SECONDS=3600

# A dump running longer than this (e.g. after a silent network drop) is killed.
GUARDIAN_DUMP_TIMEOUT_SECONDS=14400

# Where SQLite (guardian.db) and backup files (backups/) live inside the container.
GUARDIAN_DATA_DIR=/data
